# PhishGuard Environment Configuration
# Copy to .env and fill in values

# ── Application ──
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret

# ── Database ──
# SQLite (development default)
DATABASE_URL=sqlite:///./phishguard.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/phishguard

# ── ML Model ──
MODEL_PATH=ml/models/model.joblib
SCALER_PATH=ml/models/scaler.joblib
MODEL_METADATA_PATH=ml/models/model_metadata.json

# ── Threat Intel (optional) ──
PHISHTANK_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# ── Risk Thresholds ──
THRESHOLD_LOW=30
THRESHOLD_MEDIUM=60
THRESHOLD_HIGH=85

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60
